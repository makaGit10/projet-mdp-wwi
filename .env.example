# --- Source : SQL Server (authentification Windows) ---
MSSQL_SERVER=localhost
MSSQL_DATABASE=WideWorldImporters
MSSQL_DRIVER="ODBC Driver 18 for SQL Server"

# --- Cible : Snowflake ---
# Identifiant de compte au format ORGANISATION-COMPTE (resultat de la derniere requete de snowflake/setup.sql)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=WWI_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=C:/mdp_wwi/keys/rsa_key.p8
SNOWFLAKE_ROLE=WWI_ROLE
SNOWFLAKE_READER_ROLE=WWI_READER
SNOWFLAKE_WAREHOUSE=WWI_WH
SNOWFLAKE_DATABASE=WWI_MDP

# --- IA Text-to-SQL (modeles open source) ---
# Cle gratuite Groq (https://console.groq.com/keys) : reponses en quelques secondes.
# Sans cle, l'application utilise le modele local Ollama (plus lent, sans Internet).
GROQ_API_KEY=
# Laisser vide pour le choix automatique, ou forcer un modele (ex : ollama:qwen2.5-coder:3b)
LLM_MODEL=
